# Ejemplos ficticios para desarrollo local. Cambiar antes de crear el volumen.
POSTGRES_USER=cilgas
POSTGRES_DB=cilgas
POSTGRES_PASSWORD=cambiar-clave-local

# Si la clave contiene caracteres reservados, codificarlos en las URL.
DATABASE_URL=postgresql://cilgas:cambiar-clave-local@localhost:55432/cilgas
DATABASE_URL_DOCKER=postgresql://cilgas:cambiar-clave-local@postgres:5432/cilgas
# Base efímera del perfil test. Nunca usar datos reales.
TEST_DATABASE_URL=postgresql://cilgas:cambiar-clave-local@localhost:55433/cilgas_test
# Opcional: si se omite, E2E deriva esta URL de TEST_DATABASE_URL cambiando la base.
E2E_DATABASE_URL=postgresql://cilgas:cambiar-clave-local@localhost:55433/cilgas_e2e_test

NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173

# Sólo para el comando explícito de alta inicial; sin contraseña predeterminada.
BOOTSTRAP_ADMIN_NAME=Administrador local
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=
