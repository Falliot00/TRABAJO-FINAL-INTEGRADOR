generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          BigInt @id @default(autoincrement())
  code        String @unique @map("codigo") @db.VarChar(30)
  name        String @map("nombre") @db.VarChar(80)
  description String @map("descripcion")
  permissions RolePermission[]
  users       User[]
  @@map("roles")
}

model Permission {
  id          BigInt @id @default(autoincrement())
  code        String @unique @map("codigo") @db.VarChar(80)
  description String @map("descripcion")
  roles       RolePermission[]
  @@map("permisos")
}

model RolePermission {
  roleId       BigInt @map("rol_id")
  permissionId BigInt @map("permiso_id")
  role         Role @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
  @@map("roles_permisos")
}

model User {
  id           BigInt @id @default(autoincrement())
  roleId       BigInt @map("rol_id")
  name         String @map("nombre") @db.VarChar(120)
  email        String @db.VarChar(254)
  passwordHash String @map("password_hash")
  active       Boolean @default(true) @map("activo")
  createdAt    DateTime @default(now()) @map("creado_en") @db.Timestamptz
  role         Role @relation(fields: [roleId], references: [id])
  sessions     Session[]
  events       Audit[]
  drafts       ServiceDraft[]
  @@map("usuarios")
}

model Session {
  id        BigInt @id @default(autoincrement())
  userId    BigInt @map("usuario_id")
  tokenHash String @unique @map("token_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz
  expiresAt DateTime @map("vence_en") @db.Timestamptz
  revokedAt DateTime? @map("revocado_en") @db.Timestamptz
  user      User @relation(fields: [userId], references: [id])
  @@index([userId, expiresAt], map: "ix_sesiones_usuario_vencimiento")
  @@map("sesiones")
}

model Audit {
  id            BigInt @id @default(autoincrement())
  actorId       BigInt? @map("usuario_id")
  occurredAt    DateTime @default(now()) @map("ocurrido_en") @db.Timestamptz
  action        String @map("accion") @db.VarChar(80)
  entity        String @map("entidad") @db.VarChar(80)
  entityId      String? @map("entidad_clave") @db.VarChar(100)
  result        String @map("resultado") @db.VarChar(15)
  detail        String? @map("detalle")
  correlationId String? @map("correlacion_id") @db.Uuid
  actor         User? @relation(fields: [actorId], references: [id])
  @@index([occurredAt], map: "ix_auditoria_fecha")
  @@index([entity, entityId, occurredAt], map: "ix_auditoria_entidad")
  @@map("auditoria")
}

model Workshop {
  id       BigInt @id @default(1)
  name     String @map("nombre") @db.VarChar(180)
  cuit     String? @db.VarChar(20)
  address  String? @map("domicilio") @db.VarChar(220)
  locality String? @map("localidad") @db.VarChar(100)
  province String? @map("provincia") @db.VarChar(100)
  phone    String? @map("telefono") @db.VarChar(40)
  email    String? @db.VarChar(254)
  tdmId    BigInt? @map("tdm_id")
  tdmType  String @default("TDM") @map("tdm_tipo") @db.VarChar(5)
  tdm      RegulatoryActor? @relation(fields: [tdmId, tdmType], references: [id, type])
  @@map("configuracion_taller")
}

model RegulatoryActor {
  id                   BigInt @id @default(autoincrement())
  type                 String @map("tipo") @db.VarChar(5)
  code                 String @map("codigo") @db.VarChar(40)
  name                 String @map("nombre") @db.VarChar(180)
  cuit                 String? @db.VarChar(20)
  address              String? @map("domicilio") @db.VarChar(220)
  locality             String? @map("localidad") @db.VarChar(100)
  phone                String? @map("telefono") @db.VarChar(40)
  technicalResponsible String? @map("responsable_tecnico") @db.VarChar(140)
  responsibleLicense   String? @map("matricula_responsable") @db.VarChar(40)
  active               Boolean @default(true) @map("activo")
  workshops            Workshop[]
  @@unique([type, code])
  @@unique([id, type])
  @@map("actores_regulatorios")
}

model ComponentModel {
  id               BigInt @id @default(autoincrement())
  type             String @map("tipo") @db.VarChar(15)
  homologationCode String @map("codigo_homologacion") @db.VarChar(50)
  brand            String? @map("marca") @db.VarChar(100)
  model            String? @map("modelo") @db.VarChar(100)
  capacityLiters   Decimal? @map("capacidad_litros") @db.Decimal(7, 2)
  active           Boolean @default(true) @map("activo")
  components       Component[]
  @@unique([type, homologationCode])
  @@unique([id, type])
  @@map("modelos_componentes")
}

model Component {
  id               BigInt @id @default(autoincrement())
  modelId          BigInt @map("modelo_id")
  type             String @map("tipo") @db.VarChar(15)
  serialNumber     String @map("numero_serie") @db.VarChar(80)
  manufactureMonth DateTime? @map("fabricacion_mes") @db.Date
  notes            String? @map("observaciones")
  model            ComponentModel @relation(fields: [modelId, type], references: [id, type], onUpdate: Restrict, onDelete: Restrict)
  @@unique([modelId, serialNumber])
  @@unique([id, type])
  @@map("componentes")
}

model Supplier {
  id       BigInt @id @default(autoincrement())
  name     String @map("nombre_razon_social") @db.VarChar(180)
  cuit     String? @unique @db.VarChar(20)
  phone    String? @map("telefono") @db.VarChar(40)
  email    String? @db.VarChar(254)
  notes    String? @map("observaciones")
  active   Boolean @default(true) @map("activo")
  items    CatalogItem[]
  @@map("proveedores")
}

model CatalogOffer {
  id             BigInt @id @default(autoincrement())
  code           String @unique @map("codigo") @db.VarChar(40)
  name           String @map("nombre") @db.VarChar(140)
  description    String @map("descripcion")
  type           String @map("tipo") @db.VarChar(25)
  suggestedPrice Decimal @map("precio_sugerido") @db.Decimal(14, 2)
  active         Boolean @default(true) @map("activo")
  items          CatalogItem[]
  drafts         ServiceDraft[]
  @@map("catalogo_servicios")
}

model CatalogItem {
  id           BigInt @id @default(autoincrement())
  offerId      BigInt @map("catalogo_servicio_id")
  order        Int @map("orden") @db.SmallInt
  description  String @map("descripcion") @db.VarChar(180)
  type         String @map("tipo") @db.VarChar(20)
  quantity     Decimal @map("cantidad") @db.Decimal(10, 2)
  unitPrice    Decimal @map("precio_unitario") @db.Decimal(14, 2)
  supplierId   BigInt? @map("proveedor_id")
  unitCost     Decimal @default(0) @map("costo_unitario") @db.Decimal(14, 2)
  offer        CatalogOffer @relation(fields: [offerId], references: [id], onUpdate: Restrict, onDelete: Restrict)
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onUpdate: Restrict, onDelete: Restrict)
  draftItems   ServiceDraftItem[]
  @@unique([offerId, order])
  @@map("catalogo_items")
}

model Person {
  id             BigInt @id @default(autoincrement())
  type           String @map("tipo") @db.VarChar(10)
  name           String @map("nombre_razon_social") @db.VarChar(180)
  documentType   String @map("documento_tipo") @db.VarChar(20)
  documentNumber String @map("documento_numero") @db.VarChar(30)
  street         String? @map("calle") @db.VarChar(180)
  streetNumber   String? @map("numero") @db.VarChar(20)
  floorApartment String? @map("piso_depto") @db.VarChar(40)
  locality       String? @map("localidad") @db.VarChar(100)
  province       String? @map("provincia") @db.VarChar(100)
  postalCode     String? @map("codigo_postal") @db.VarChar(15)
  phone          String? @map("telefono") @db.VarChar(40)
  email          String? @db.VarChar(254)
  active         Boolean @default(true) @map("activo")
  createdAt      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  relationships  VehicleRelationship[]
  serviceRoles   ServiceDraftPerson[]
  @@unique([documentType, documentNumber])
  @@index([name], map: "ix_personas_nombre")
  @@map("personas")
}

model Vehicle {
  id              BigInt @id @default(autoincrement())
  plate           String @unique @map("dominio") @db.VarChar(15)
  brand           String @map("marca") @db.VarChar(80)
  model           String @map("modelo") @db.VarChar(100)
  year            Int @map("anio") @db.SmallInt
  engineNumber    String? @map("motor_numero") @db.VarChar(80)
  chassisNumber   String? @map("chasis_numero") @db.VarChar(80)
  type            String? @map("tipo") @db.VarChar(15)
  otherTypeDetail String? @map("tipo_otro_detalle") @db.VarChar(100)
  usage           String? @map("uso") @db.VarChar(60)
  injection       Boolean? @map("inyeccion")
  active          Boolean @default(true) @map("activo")
  relationships   VehicleRelationship[]
  drafts          ServiceDraft[]
  @@map("vehiculos")
}

model VehicleRelationship {
  id        BigInt @id @default(autoincrement())
  vehicleId BigInt @map("vehiculo_id")
  personId  BigInt @map("persona_id")
  role      String @map("rol") @db.VarChar(15)
  from      DateTime @map("desde") @db.Date
  until     DateTime? @map("hasta") @db.Date
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  person    Person @relation(fields: [personId], references: [id])
  @@index([personId, vehicleId], map: "ix_vehiculo_personas_persona")
  @@map("vehiculo_personas")
}

model ServiceDraft {
  id BigInt @id @default(autoincrement())
  vehicleId BigInt @map("vehiculo_id")
  catalogOfferId BigInt @map("catalogo_servicio_id")
  version Int @default(1)
  status String @map("estado") @db.VarChar(15)
  serviceDate DateTime @map("fecha_servicio") @db.Date
  description String @map("descripcion") @db.VarChar(180)
  type String @map("tipo") @db.VarChar(25)
  sheetOperation String? @map("operacion_ficha") @db.Char(1)
  phReason String? @map("motivo_ph") @db.VarChar(20)
  includesPh Boolean @default(false) @map("incluye_ph")
  totalAmount Decimal @map("importe_total") @db.Decimal(14, 2)
  notes String? @map("observaciones")
  createdBy BigInt @map("creado_por")
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz
  confirmedBy BigInt? @map("confirmado_por")
  confirmedAt DateTime? @map("confirmado_en") @db.Timestamptz
  configurationBaseId BigInt? @map("configuracion_base_id")
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  catalogOffer CatalogOffer @relation(fields: [catalogOfferId], references: [id])
  creator User @relation(fields: [createdBy], references: [id])
  people ServiceDraftPerson[]
  items ServiceDraftItem[]
  costs ServiceDraftCost[]
  preparation ServicePreparation?
  interventions ServiceIntervention[]
  @@unique([id, vehicleId])
  @@index([vehicleId, serviceDate], map: "ix_servicios_vehiculo_fecha")
  @@index([status, serviceDate], map: "ix_servicios_estado_fecha")
  @@map("servicios")
}
model ServiceDraftPerson {
  serviceId BigInt @map("servicio_id")
  personId BigInt @map("persona_id")
  role String @map("rol") @db.VarChar(15)
  service ServiceDraft @relation(fields: [serviceId], references: [id])
  person Person @relation(fields: [personId], references: [id])
  @@id([serviceId, role])
  @@index([personId, serviceId], map: "ix_servicio_personas_persona")
  @@map("servicio_personas")
}
model ServiceDraftItem {
  id BigInt @id @default(autoincrement())
  serviceId BigInt @map("servicio_id")
  order Int @map("orden") @db.SmallInt
  catalogItemId BigInt? @map("catalogo_item_id")
  description String @map("descripcion") @db.VarChar(180)
  type String @map("tipo") @db.VarChar(20)
  componentId BigInt? @map("componente_id")
  action String? @map("accion") @db.VarChar(15)
  quantity Decimal @map("cantidad") @db.Decimal(10, 2)
  unitPrice Decimal @map("precio_unitario") @db.Decimal(14, 2)
  discount Decimal @default(0) @map("descuento") @db.Decimal(14, 2)
  amount Decimal @map("importe") @db.Decimal(14, 2)
  service ServiceDraft @relation(fields: [serviceId], references: [id])
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  costs ServiceDraftCost[]
  @@unique([serviceId, order])
  @@unique([id, serviceId])
  @@map("servicio_items")
}
model ServiceDraftCost {
  id BigInt @id @default(autoincrement())
  serviceId BigInt @map("servicio_id")
  itemId BigInt? @map("servicio_item_id")
  supplierId BigInt? @map("proveedor_id")
  concept String @map("concepto") @db.VarChar(180)
  treatment String @map("tratamiento") @db.VarChar(15)
  amount Decimal @map("importe") @db.Decimal(14, 2)
  service ServiceDraft @relation(fields: [serviceId], references: [id])
  item ServiceDraftItem? @relation(fields: [itemId, serviceId], references: [id, serviceId])
  @@unique([id, serviceId, supplierId, amount])
  @@index([serviceId], map: "ix_servicio_costos_servicio")
  @@map("servicio_costos")
}
model ServicePreparation {
  serviceId BigInt @id @map("servicio_id")
  pecId BigInt? @map("pec_id")
  tdmId BigInt? @map("tdm_id")
  previousStickerExpiresOn DateTime? @map("oblea_anterior_vence_el") @db.Date
  previousSticker String? @map("oblea_anterior") @db.VarChar(40)
  newSticker String? @map("oblea_nueva") @db.VarChar(40)
  enabledOn DateTime? @map("habilitada_el") @db.Date
  expiresOn DateTime? @map("vence_el") @db.Date
  notes String? @map("observaciones_ficha")
  service ServiceDraft @relation(fields: [serviceId], references: [id])
  @@map("servicio_preparacion")
}
model ServiceIntervention {
  cylinderId BigInt? @map("cilindro_id")
  id BigInt @id @default(autoincrement())
  serviceId BigInt @map("servicio_id")
  type String @map("tipo") @db.VarChar(15)
  row Int @map("renglon") @db.SmallInt
  componentId BigInt? @map("componente_id")
  homologationCode String? @map("codigo_homologacion") @db.VarChar(50)
  serialNumber String? @map("numero_serie") @db.VarChar(80)
  condition String? @map("condicion") @db.VarChar(30)
  action String? @map("accion") @db.Char(1)
  finalPosition Int? @map("posicion_final") @db.SmallInt
  manufactureMonth DateTime? @map("fabricacion_mes") @db.Date
  revisionMonth DateTime? @map("revision_mes") @db.Date
  crpcId BigInt? @map("crpc_id")
  performsPh Boolean @default(false) @map("realiza_ph")
  testDate String? @map("fecha_ensayo") @db.VarChar(10)
  revisionExpiresOn DateTime? @map("vence_revision_el") @db.Date
  phResult String? @map("resultado_ph") @db.VarChar(15)
  certificateNumber String? @map("numero_certificado") @db.VarChar(80)
  description String? @map("descripcion") @db.VarChar(180)
  service ServiceDraft @relation(fields: [serviceId], references: [id])
  @@unique([serviceId, type, row])
  @@map("servicio_intervenciones")
}
